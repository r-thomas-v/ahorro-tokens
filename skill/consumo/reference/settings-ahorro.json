{
  "_comentario": "Reglas que /consumo optimizar AÑADE a permissions.deny de ~/.claude/settings.json. Nunca borra nada existente.",
  "pesados": [
    "Read(**/node_modules/**)",
    "Read(**/.next/**)",
    "Read(**/dist/**)",
    "Read(**/build/**)",
    "Read(**/.vercel/**)",
    "Read(**/.git/**)",
    "Read(**/coverage/**)",
    "Read(**/package-lock.json)",
    "Read(**/pnpm-lock.yaml)",
    "Read(**/yarn.lock)",
    "Read(**/*.min.js)",
    "Read(**/*.min.css)",
    "Read(**/*.map)"
  ],
  "aviso": {
    "_comentario": "Se añade dentro de hooks.UserPromptSubmit. Sustituir <RUTA_SKILL> por la ruta absoluta de la skill.",
    "hooks": [
      { "type": "command", "command": "python -I \"<RUTA_SKILL>/scripts/aviso_contexto.py\"", "timeout": 10 }
    ]
  },
  "secretos": [
    "Read(**/.env)",
    "Read(**/.env.local)",
    "Read(**/.env.production)",
    "Read(**/.env.development)",
    "Read(**/*.pem)",
    "Read(**/*.key)",
    "Read(~/.ssh/**)",
    "Read(~/.claude/.credentials.json)"
  ]
}
